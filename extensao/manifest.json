{
  "manifest_version": 3,
  "name": "Explica PR — revisor de código",
  "version": "0.6.0",
  "description": "Escolha o que quer revisar em commits e pull requests do GitHub.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "scripts": ["servico-fundo.js"],
    "service_worker": "servico-fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/commit/*",
        "https://github.com/*/*/pull/*",
        "https://github.com/*/*/compare/*"
      ],
      "js": ["revisor-na-pagina.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Explica PR",
    "default_popup": "janela.html"
  },
  "options_ui": {
    "page": "configuracoes.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "explica-pr@viniciuscampeao.dev",
      "strict_min_version": "128.0"
    }
  }
}
